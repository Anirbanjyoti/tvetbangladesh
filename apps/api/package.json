{
  "name": "@tvet/api",
  "version": "1.0.0",
  "private": true,
  "description": "TVET Bangladesh Core Express.js Modular Monolith API",
  "main": "./dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
