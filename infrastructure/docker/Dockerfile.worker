# ==============================================================================
# Multi-stage Dockerfile for @tvet/worker
# ==============================================================================

FROM node:20-alpine AS base
RUN apk add --no-cache libc6-compat
WORKDIR /app

# Stage 1: Pruning with Turbo
FROM base AS builder
RUN npm install -g turbo
COPY . .
RUN turbo prune @tvet/worker --docker

# Stage 2: Install and build
FROM base AS installer
COPY --from=builder /app/out/json/ .
COPY --from=builder /app/out/package-lock.json ./package-lock.json
RUN npm ci

COPY --from=builder /app/out/full/ .
RUN npx turbo run build --filter=@tvet/worker

# Stage 3: Runner
FROM base AS runner
WORKDIR /app

ENV NODE_ENV=production
ENV PORT=5001

RUN addgroup --system --gid 1001 nodejs
RUN adduser --system --uid 1001 workerjs

COPY --from=installer /app/node_modules ./node_modules
COPY --from=installer /app/packages ./packages
COPY --from=installer /app/apps/worker/dist ./apps/worker/dist
COPY --from=installer /app/apps/worker/package.json ./apps/worker/package.json

USER workerjs

EXPOSE 5001

CMD ["node", "apps/worker/dist/worker.js"]
