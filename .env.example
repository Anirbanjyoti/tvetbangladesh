# ==============================================================================
# TVET Bangladesh Environment Configuration Template
# Copy this file to .env or configure in deployment orchestrator
# ==============================================================================

# Node Environment
NODE_ENV=development

# ------------------------------------------------------------------------------
# Apps / Services Ports
# ------------------------------------------------------------------------------
API_PORT=5000
WEB_PORT=3000
WORKER_PORT=5001

# Public URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1

# ------------------------------------------------------------------------------
# Database & Cache (Local Dev defaults matching docker-compose.yml)
# ------------------------------------------------------------------------------
MONGODB_URI=mongodb://localhost:27017/tvetbangladesh?replicaSet=rs0&readPreference=primaryPreferred
REDIS_URL=redis://localhost:6379

# ------------------------------------------------------------------------------
# Logging
# ------------------------------------------------------------------------------
LOG_LEVEL=debug

# ------------------------------------------------------------------------------
# CORS & Security
# ------------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://*.localhost:3000

# ------------------------------------------------------------------------------
# Placeholders for future phases (Authentication, LiveKit, Payments, Firebase)
# ------------------------------------------------------------------------------
FIREBASE_PROJECT_ID=tvet-bangladesh-dev
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@tvet-bangladesh-dev.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

LIVEKIT_URL=http://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
